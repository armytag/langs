with: std-ipa-features std-assimilations
random-rate: 20

letters: a i u e o ə m n p t k b d g f s x w r l j ʈ ɖ ʂ tʃ ʃ dʒ ʒ ts ʈ ʂ ː

C = t k n p d m s b g l j x w f
O = k t s d p b g
G = r j w
R = n m
V = a i e u o
I = e o u i

$L = CV'
$H = OG?V'
$F = CVR?'

words: 'I?$H$F 'I?$F$F 'I?$H$L$F 'I?$L$H$F 'I?$F 'I?$H 'I?$L
# filter: aː > aa; iː > ii; uː > uu; eː > ee; oː > oo
reject: (..+)\1+

filter: 'mu' > 'm'; 'ni' > 'n'
filter: ji > jə; wu > wə
filter: tj > tʃ; sj > ʃ; dj > dʒ
filter: kj > ts; gj > ʒ; xj > ʃ
filter: pj > pl; bj > bl; fj > fl
filter: tr > ʈ; dr > ɖ; sr > ʂ
filter: ' > !
