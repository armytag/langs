class cons {m, n, p, t, j, k, s, c, ɕ, x, w, l, y}
class stop {t, k, p, s, j, c, ɕ}
class res {n, m, y, w, l, h}
class glide {y, w, l, h}
class nasal {n, m}
class lateral {l}
class vowel {a, i, u, e, ə, o, uː, oː, aː, ɯ, eo}

Syllables:
@stop @glide? @vowel @res
@res @vowel @res
@stop @glide? @vowel
@res @vowel
{@stop @glide?, @res} @vowel @cons / _ $

t1:
x => h

t2:
cy => ɕ

nasal-assimilation:
{mn, nm} => {nn, mm}

t3:
{@cons&!@nasal&!@lateral, @vowel} => * / @vowel @cons @vowel? _ $

vowel-mayhem:
y {i, u, o, ə, a, e} y => * {hi, hɯy, hoy, hay, hay, he} * / . @cons _ @res? .
y {i, u, o, ə, a, e} w => * {hɯ, hu, ho, ho, ha, heo} * / . @cons _ @res? .
w {i, u, o, ə, a, e} y => * {ɯy, ɯy, oy, oy, ay, e} * / . @cons _ @res? .
w {i, u, o, ə, a, e} w => * {ɯ, uː, uː, oː, aː, eo} * / . @cons _ @res? .
y {i, u, o, ə, a, e} => * {hi, hu, ho, hə, ha, he} / . @cons _ @res? .
w {i, u, o, ə, a, e} => * {wi, u, wo, wə, wa, we} / . @cons _ @res? .
{i, u, o, ə, a, e} y => {ɯ, ɯy, oy, ay, ay, e} * / . @cons _ @res? .
{i, u, o, ə, a, e} w => {ɯ, uː, oː, oː, aː, eo} * / . @cons _ @res? .

