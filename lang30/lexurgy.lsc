class cons {m, n, p, t, c, k, s, ʃ, ɕ, x, w, l, j, r, h}
class stop {t, k, p, s, c, ʃ, x, ɕ, h}
class res {n, m, j, w, l, h, r}
class glide {j, w, l, h, r}
class nasal {n, m}
class lateral {l}
class vowel {a, i, u, e, ə, o, uː, oː, aː, ɯ, eo}

Syllables:
@stop @glide? @vowel @res
@res @vowel @res
@stop @glide? @vowel
@res @vowel
{@stop @glide?, @res} @vowel @cons / _ $

t1:
x => h

t2:
ʃ j => ɕ *

nasal-assimilation:
{mn, nm} => {nn, mm}

t3:
{@cons&!@nasal&!@lateral, e, ə, o} => * / @vowel @cons @vowel? _ $

vowel-mayhem:
j {i, u, o, ə, a, e} j => * {hi, hɯj, hoj, haj, haj, he} * / @stop _ @res? .
j {i, u, o, ə, a, e} w => * {hɯ, hu, ho, ho, ha, heo} * / @stop _ @res? .
w {i, u, o, ə, a, e} j => * {ɯj, ɯj, oj, oj, aj, e} * / @stop _ @res? .
w {i, u, o, ə, a, e} w => * {ɯ, uː, uː, oː, aː, eo} * / @stop _ @res? .
j {i, u, o, ə, a, e} => * {hi, hu, ho, hə, ha, he} / @stop _ @res? .
w {i, u, o, ə, a, e} => * {wi, u, wo, wə, wa, we} / @stop _ @res? .
{i, u, o, ə, a, e} j => {ɯ, ɯj, oj, aj, aj, e} * / @stop _ @res? .
{i, u, o, ə, a, e} w => {ɯ, uː, oː, oː, aː, eo} * / @stop _ @res? .
Then: hh => h

l-metathesis:
l$1 {k, p}$2 => $2 $1 / @vowel _ @vowel

wl-glide-shift:
w => r / {p, m} _ @vowel // _ i
l => r / {p, k, t} _ @vowel

super-reduplication-cleanup:
@cons$1 @vowel$2 => $1 * / @vowel _ $1 $2

Syllables:
@stop @glide? @vowel @res
@res @vowel @res
@stop @glide? @vowel
@res @vowel
{@stop @glide?, @res} @vowel @cons / _ $
@cons @glide? @vowel @stop / _ @stop

romanizer-phonetic:
unchanged

final:
unchanged

Syllables:
clear

romanizer:
{ʃ, ɕ} => {x, sy}
j => y
{ɯ, ə} => {ï, ë}
{uː, oː, aː} => {uu, oo, aa}
# {t, p, k} => {d, b, g} / {@vowel, @res} _ // _ {h, r, @stop, $}